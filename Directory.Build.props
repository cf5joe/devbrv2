<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!-- Windows 11 x64 only. Default the platform so project-level and solution builds share one output path. -->
    <Platform Condition="'$(Platform)' == '' or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Reproducible, locked restores with vulnerability auditing. -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>

    <Version>0.1.0</Version>
    <Company>DevBR</Company>
    <Product>DevBR</Product>
    <Copyright>Copyright © DevBR contributors</Copyright>

    <!-- "Development" unless a release build explicitly says otherwise (see build/publish.ps1). -->
    <DevBRReleaseChannel Condition="'$(DevBRReleaseChannel)' == ''">Development</DevBRReleaseChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="DevBR.ReleaseChannel" Value="$(DevBRReleaseChannel)" />
  </ItemGroup>
</Project>
