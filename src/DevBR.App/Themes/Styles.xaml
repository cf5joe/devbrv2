<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Typography -->
    <FontFamily x:Key="DevBR.FontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="DevBR.DisplayFontFamily">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="DevBR.IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 8 px spacing scale and radii -->
    <Thickness x:Key="DevBR.PagePadding">40,32,40,40</Thickness>
    <Thickness x:Key="DevBR.CardPadding">24,20,24,20</Thickness>
    <CornerRadius x:Key="DevBR.RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="DevBR.RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="DevBR.RadiusLarge">12</CornerRadius>
    <sys:Double x:Key="DevBR.ContentMaxWidth">1040</sys:Double>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Text -->
    <Style x:Key="Text.PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DevBR.DisplayFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Lead" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource DevBR.TextMuted}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.TextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.AccentText}" />
    </Style>

    <Style x:Key="Text.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DevBR.IconFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DevBR.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DevBR.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource DevBR.RadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource DevBR.CardPadding}" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource DevBR.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DevBR.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2,8,3" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <Style x:Key="Divider" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{DynamicResource DevBR.Border}" />
        <Setter Property="Margin" Value="0,16" />
    </Style>

    <!-- Focus ring: 2 px accent outline, visible on keyboard focus only. -->
    <Style x:Key="DevBR.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderBrush="{DynamicResource DevBR.AccentText}" BorderThickness="2" CornerRadius="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DevBR.AccentForeground}" />
        <Setter Property="Background" Value="{DynamicResource DevBR.Accent}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DevBR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="Background" Value="{DynamicResource DevBR.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DevBR.Border}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DevBR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DevBR.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DevBR.AccentSubtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <!-- Large action card used for the Overview's primary actions. -->
    <Style x:Key="Button.ActionCard" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="Background" Value="{DynamicResource DevBR.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DevBR.Border}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DevBR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource DevBR.RadiusLarge}" Padding="24" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DevBR.Accent}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DevBR.SurfaceElevated}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DevBR.AccentSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource DevBR.TextMuted}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DevBR.FocusVisual}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                Background="{DynamicResource DevBR.Accent}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DevBR.SurfaceElevated}" />
                            <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource DevBR.AccentSubtle}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Option lists (theme presets, accents): arrow-key navigation, announced as selected. -->
    <Style x:Key="OptionList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Selectable option card (theme presets) -->
    <Style x:Key="OptionCard" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource DevBR.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DevBR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="{DynamicResource DevBR.SurfaceElevated}" BorderBrush="{DynamicResource DevBR.Border}"
                            BorderThickness="1" CornerRadius="{StaticResource DevBR.RadiusMedium}" Padding="12">
                        <Grid>
                            <ContentPresenter />
                            <Border x:Name="Check" Width="20" Height="20" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Background="{DynamicResource DevBR.Accent}" Visibility="Collapsed">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource DevBR.IconFontFamily}" FontSize="11"
                                           Foreground="{DynamicResource DevBR.AccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DevBR.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DevBR.Accent}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent swatch: a color circle with a checkmark (not color alone) when selected. -->
    <Style x:Key="Swatch" TargetType="ListBoxItem">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource DevBR.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Ellipse x:Name="Ring" Stroke="{DynamicResource DevBR.Border}" StrokeThickness="2" Fill="{TemplateBinding Background}" />
                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="{StaticResource DevBR.IconFontFamily}" FontSize="14"
                                   Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource DevBR.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource DevBR.Text}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
