<UserControl x:Class="DevBR.App.Views.RestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:DevBR.App.ViewModels"
             xmlns:controls="clr-namespace:DevBR.App.Controls"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:RestoreViewModel}">
    <StackPanel>
        <TextBlock Text="RESTORE" Style="{StaticResource Text.Overline}" />
        <TextBlock Text="Restore from a backup" Style="{StaticResource Text.PageTitle}" Margin="0,6,0,0" />
        <TextBlock Style="{StaticResource Text.Lead}" Margin="0,10,0,0" MaxWidth="720" HorizontalAlignment="Left"
                   Text="Open a .devbr file to see what it contains. Nothing is restored until you have reviewed and approved a plan for this computer." />

        <!-- Step 1: choose a file -->
        <Border Style="{StaticResource Card}" Margin="0,28,0,0" Visibility="{Binding IsChooseFile, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Choose a backup file" Style="{StaticResource Text.SectionTitle}" />
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,20"
                           Text="DevBR reads the backup's index and manifest in an isolated background process. Archive contents are never executed." />
                <Button Style="{StaticResource Button.Primary}" Command="{Binding BrowseCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource DevBR.AccentForeground}" Margin="0,0,10,0" />
                        <TextBlock Text="Browse for a backup…" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Inspecting -->
        <Border Style="{StaticResource Card}" Margin="0,28,0,0" Visibility="{Binding IsInspecting, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding FileName, StringFormat='Reading {0}…'}" Style="{StaticResource Text.SectionTitle}" />
                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,16" AutomationProperties.Name="Reading backup" />
                <Button Style="{StaticResource Button.Secondary}" Command="{Binding CancelInspectionCommand}" Content="Cancel" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Step 2: password -->
        <Border Style="{StaticResource Card}" Margin="0,28,0,0" Visibility="{Binding IsNeedsPassword, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="18" Foreground="{DynamicResource DevBR.AccentText}" Margin="0,0,12,0" />
                    <TextBlock Text="This backup is encrypted" Style="{StaticResource Text.SectionTitle}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" Margin="0,6,0,16"
                           Text="{Binding FileName, StringFormat='Enter the password for {0}. Its contents, including file names, stay hidden until it is unlocked.'}" />
                <TextBlock Text="Password" Style="{StaticResource Text.Label}" Margin="0,0,0,6" />
                <PasswordBox x:Name="Password" MaxWidth="360" HorizontalAlignment="Left" Width="360" KeyDown="OnPasswordKeyDown"
                             AutomationProperties.Name="Backup password" />
                <TextBlock Text="{Binding PasswordError}" Foreground="{DynamicResource DevBR.Error}" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="Unlock" Click="OnUnlockClick" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Choose another file" Command="{Binding StartOverCommand}" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Failure -->
        <StackPanel Margin="0,28,0,0" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisibility}}">
            <controls:InfoBar Severity="Error" Title="{Binding ErrorTitle}" Message="{Binding ErrorMessage}" />
            <Button Style="{StaticResource Button.Secondary}" Content="Choose another file" Command="{Binding StartOverCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
        </StackPanel>

        <!-- Step 3: overview -->
        <StackPanel Margin="0,28,0,0" Visibility="{Binding IsOverview, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Choose another file" Command="{Binding StartOverCommand}" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource Text.SectionTitle}" />
                            <TextBlock Text="Backup overview" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Style="{StaticResource Divider}" />
                    <ItemsControl ItemsSource="{Binding Details}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DetailRow}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Muted}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Style="{StaticResource Text.Body}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding CaptureWarnings}" Margin="0,16,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:InfoBar Severity="Warning" Title="Captured with a warning" Message="{Binding}" Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="What this backup contains" Style="{StaticResource Text.SectionTitle}" Margin="0,24,0,12" />
            <Grid Height="420">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}" Padding="4">
                    <ListBox ItemsSource="{Binding Artifacts}" SelectedItem="{Binding SelectedArtifact}" AutomationProperties.Name="Backup contents"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BackupArtifactRow}">
                                <StackPanel Margin="4,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="Icon" Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="12" Foreground="{DynamicResource DevBR.Warning}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="20,0,0,0">
                                        <Run Text="{Binding Owner, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Detail, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter TargetName="Icon" Property="Text" Value="&#xE930;" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DevBR.Success}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" DataContext="{Binding SelectedArtifact}" Margin="0,0,0,8">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" TextTrimming="CharacterEllipsis" />
                            <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource DevBR.Warning}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding EntriesNote}" Style="{StaticResource Text.Caption}" Visibility="{Binding EntriesNote, Converter={StaticResource HasValue}}" />
                        <ListBox ItemsSource="{Binding Entries}" AutomationProperties.Name="Files in the selected item" Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="8,3" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BackupEntryRow}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Style="{StaticResource Text.Caption}" Margin="8,0,0,0" />
                                        <TextBlock Text="{Binding Path}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Plan the restore: items, destinations, preflight, review, approval -->
            <TextBlock Text="Plan the restore" Style="{StaticResource Text.SectionTitle}" Margin="0,32,0,4" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12">
                <Run Text="Restoring to: " /><Run Text="{Binding TargetLabel, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=". Preflight only reads this computer; nothing changes until a plan is approved and run." />
            </TextBlock>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Items to restore" Style="{StaticResource Text.Label}" />
                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,8,0,0" Focusable="False" AutomationProperties.Name="Items to restore">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RestoreItemRow}">
                                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0,0,12,6" AutomationProperties.Name="{Binding Name}">
                                    <TextBlock TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding Owner, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource DevBR.TextMuted}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding RunPreflightCommand}" AutomationProperties.Name="Run preflight">
                            <TextBlock Text="{Binding HasPreflight, Converter={x:Static vm:RestoreLabels.PreflightLabel}}" />
                        </Button>
                        <TextBlock Text="{Binding PreflightStatus}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="16,0,0,0" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,12,0,0" Visibility="{Binding IsPreflighting, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Preflight in progress" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasPreflight, Converter={StaticResource BoolToVisibility}}" Margin="0,16,0,0">
                <TextBlock Text="{Binding PreflightSummary}" Style="{StaticResource Text.Label}" Margin="0,0,0,12" AutomationProperties.LiveSetting="Polite" />

                <!-- Destinations -->
                <TextBlock Text="Destinations" Style="{StaticResource Text.SectionTitle}" FontSize="15" Margin="0,8,0,8" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl ItemsSource="{Binding MappingRows}" Focusable="False" AutomationProperties.Name="Destinations">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MappingRow}">
                                <Border BorderBrush="{DynamicResource DevBR.Border}" BorderThickness="0,0,0,1" Padding="16,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Change…" VerticalAlignment="Center"
                                                Command="{Binding DataContext.ChangeMappingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanChange, Converter={StaticResource BoolToVisibility}}" AutomationProperties.Name="{Binding Source, StringFormat='Change destination for {0}'}" />
                                        <StackPanel>
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Source, Mode=OneWay}" /><Run Text="  →  " Foreground="{DynamicResource DevBR.TextMuted}" /><Run Text="{Binding Target, Mode=OneWay}" FontWeight="SemiBold" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Text.Caption}">
                                                <Run Text="{Binding Origin, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusLabel, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Findings -->
                <TextBlock Text="Preflight findings" Style="{StaticResource Text.SectionTitle}" FontSize="15" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding Findings}" Focusable="False" AutomationProperties.Name="Preflight findings">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FindingView}">
                            <controls:InfoBar Severity="{Binding Severity}" Title="{Binding Title}" Message="{Binding Message}" Margin="0,0,0,8" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource Button.Secondary}" Content="Recheck" Command="{Binding RunPreflightCommand}" HorizontalAlignment="Left" Margin="0,0,0,8"
                        AutomationProperties.Name="Recheck preflight" />

                <!-- Review -->
                <TextBlock Text="Review the plan" Style="{StaticResource Text.SectionTitle}" FontSize="15" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" AutomationProperties.Name="Planned changes">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OperationGroup}">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,2,0,8" />
                                <Border Style="{StaticResource Card}" Padding="0">
                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:OperationRow}">
                                                <Border BorderBrush="{DynamicResource DevBR.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                                    <DockPanel>
                                                        <ComboBox DockPanel.Dock="Right" Width="230" VerticalAlignment="Top" Margin="12,0,0,0"
                                                                  ItemsSource="{Binding Choices}" SelectedItem="{Binding Decision}"
                                                                  Visibility="{Binding HasChoice, Converter={StaticResource BoolToVisibility}}"
                                                                  AutomationProperties.Name="{Binding Title, StringFormat='Choice for {0}'}">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Converter={x:Static vm:DecisionLabels.Label}}" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                        <StackPanel>
                                                            <WrapPanel>
                                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,0,8,2" TextTrimming="CharacterEllipsis" />
                                                                <Border Style="{StaticResource Badge}" Padding="6,0" Margin="0,0,6,2" Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVisibility}}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="10" Foreground="{DynamicResource DevBR.Warning}" Margin="0,0,4,0" />
                                                                        <TextBlock Text="Administrator" FontSize="11" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <Border Style="{StaticResource Badge}" Padding="6,0" Margin="0,0,6,2" Visibility="{Binding IsIrreversible, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="Cannot be rolled back" FontSize="11" />
                                                                </Border>
                                                                <Border Style="{StaticResource Badge}" Padding="6,0" Margin="0,0,6,2" Visibility="{Binding Enabled, Converter={StaticResource HasNoValue}}">
                                                                    <TextBlock Text="Held back" FontSize="11" />
                                                                </Border>
                                                            </WrapPanel>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding MergeSummary}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,6,0,0"
                                                                       Foreground="{DynamicResource DevBR.TextMuted}" TextWrapping="Wrap" Visibility="{Binding MergeSummary, Converter={StaticResource HasValue}}" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Expander Header="Paths rewritten for this computer" Margin="0,0,0,8" Visibility="{Binding Rewrites.Count, Converter={StaticResource HasValue}}">
                    <ItemsControl ItemsSource="{Binding Rewrites}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander Header="MCP servers in this backup" Margin="0,0,0,8" Visibility="{Binding McpServers.Count, Converter={StaticResource HasValue}}">
                    <ItemsControl ItemsSource="{Binding McpServers}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
                <Expander Header="Software to reinstall yourself" Margin="0,0,0,8" Visibility="{Binding Reinstall.Count, Converter={StaticResource HasValue}}">
                    <ItemsControl ItemsSource="{Binding Reinstall}" Margin="0,8,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Text.Caption}" Margin="0,0,0,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>

                <controls:InfoBar Severity="{Binding ApprovalSeverity}" Title="{Binding ApprovalStatus}" Margin="0,8,0,0"
                                  Visibility="{Binding ApprovalStatus, Converter={StaticResource HasValue}}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource Button.Secondary}" Content="Approve this plan" Command="{Binding ApproveCommand}" />
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding RestoreNowCommand}" Margin="8,0,0,0" AutomationProperties.Name="Restore now">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE777;" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource DevBR.AccentForeground}" Margin="0,0,10,0" />
                            <TextBlock Text="Restore now" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Steps 8–10: run, verify, report -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Restoring…" Style="{StaticResource Text.SectionTitle}" />
                    <ProgressBar Height="6" Margin="0,12,0,12" Maximum="100" Value="{Binding RestorePercent}" AutomationProperties.Name="Restore progress" />
                    <TextBlock Text="{Binding RestoreStatus}" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Cancelling stops after the current change. Changes already made are kept and can be rolled back." />
                    <Button Style="{StaticResource Button.Secondary}" Content="Cancel" Command="{Binding CancelRestoreCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,16,0,0" Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
                <controls:InfoBar Severity="{Binding RunSeverity}" Title="{Binding RunTitle}" Message="{Binding RunMessage}" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,12">
                    <Button Style="{StaticResource Button.Primary}" Content="Open report" Command="{Binding OpenReportCommand}" CommandParameter="{Binding LastRun.ReportHtmlPath}" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="0">
                    <ItemsControl ItemsSource="{Binding Results}" Focusable="False" AutomationProperties.Name="Restore results">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RestoreResultRow}">
                                <Border BorderBrush="{DynamicResource DevBR.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Padding="8,1" VerticalAlignment="Top" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Status}" FontSize="11" />
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap">
                                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Item, Mode=OneWay, StringFormat=' · {0}'}" Foreground="{DynamicResource DevBR.TextMuted}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                       Visibility="{Binding Detail, Converter={StaticResource HasValue}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </StackPanel>

        <!-- Interrupted restores and rollback, available without opening a backup -->
        <controls:InfoBar Margin="0,24,0,0" Severity="Warning" Title="A restore was interrupted" Message="{Binding RecoveryMessage}"
                          Visibility="{Binding RecoveryMessage, Converter={StaticResource HasValue}}" />
        <StackPanel Margin="0,32,0,0" Visibility="{Binding RecentRestores.Count, Converter={StaticResource HasValue}}">
            <TextBlock Text="Recent restores" Style="{StaticResource Text.SectionTitle}" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"
                       Text="Roll back undoes a restore's file and environment changes, newest first, and keeps anything changed since. Installed software is not removed." />
            <controls:InfoBar Severity="{Binding RollbackSeverity}" Title="{Binding RollbackMessage}" Margin="0,0,0,12"
                              Visibility="{Binding RollbackMessage, Converter={StaticResource HasValue}}" />
            <Border Style="{StaticResource Card}" Padding="0">
                <ItemsControl ItemsSource="{Binding RecentRestores}" Focusable="False" AutomationProperties.Name="Recent restores">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:RecentRestoreRow}">
                            <Border BorderBrush="{DynamicResource DevBR.Border}" BorderThickness="0,0,0,1" Padding="16,10">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Secondary}" Content="Report" Margin="8,0,0,0"
                                                Command="{Binding DataContext.OpenReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding ReportPath}"
                                                Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="Roll back" Margin="8,0,0,0"
                                                Command="{Binding DataContext.RollBackCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanRollBack, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Text.Caption}">
                                            <Run Text="{Binding When, Mode=OneWay}" /><Run Text="{Binding State, Mode=OneWay, StringFormat=' · {0}'}" /><Run Text="{Binding Counts, Mode=OneWay, StringFormat=' · {0}'}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
