<Window x:Class="DevBR.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:DevBR.App.ViewModels"
        xmlns:controls="clr-namespace:DevBR.App.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="DevBR"
        Width="1200" Height="800" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DevBR.Background}"
        Foreground="{DynamicResource DevBR.Text}"
        FontFamily="{StaticResource DevBR.FontFamily}"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateToIndexCommand}" CommandParameter="0" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateToIndexCommand}" CommandParameter="1" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateToIndexCommand}" CommandParameter="2" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateToIndexCommand}" CommandParameter="3" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateToIndexCommand}" CommandParameter="4" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateToIndexCommand}" CommandParameter="5" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource DevBR.Surface}" BorderBrush="{DynamicResource DevBR.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource DevBR.Accent}">
                        <controls:Glyph Text="&#xE8F7;" Style="{StaticResource Text.Icon}" FontSize="16"
                                   Foreground="{DynamicResource DevBR.AccentForeground}" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DevBR" FontFamily="{StaticResource DevBR.DisplayFontFamily}" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Developer backup &amp; restore" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,16,0,0">
                    <Border Style="{StaticResource Badge}" Visibility="{Binding IsSimulated, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource DevBR.AccentSubtle}" BorderBrush="{DynamicResource DevBR.Accent}" Margin="0,0,0,8"
                            ToolTip="{Binding MachineLabel}">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Text="&#xE7EF;" Style="{StaticResource Text.Icon}" FontSize="11" Margin="0,0,6,0" />
                            <TextBlock Text="Simulated machine" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Badge}" Visibility="{Binding IsDevelopmentBuild, Converter={StaticResource BoolToVisibility}}"
                            Background="{DynamicResource DevBR.WarningSubtle}" BorderBrush="{DynamicResource DevBR.Warning}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <controls:Glyph Text="&#xE7BA;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource DevBR.Warning}" Margin="0,0,6,0" />
                            <TextBlock Text="Development build" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding BuildLabel}" Style="{StaticResource Text.Caption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <controls:Glyph Text="&#xEA18;" Style="{StaticResource Text.Icon}" FontSize="11" Foreground="{DynamicResource DevBR.TextMuted}" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding ElevationLabel}" Style="{StaticResource Text.Caption}" />
                    </StackPanel>
                </StackPanel>

                <ListBox x:Name="Navigation" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource NavItem}"
                         ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}"
                         AutomationProperties.Name="Main navigation">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PageViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <controls:Glyph Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" Margin="14,0,0,0" FontSize="14" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:InfoBar Margin="40,20,40,0" Severity="{Binding BannerSeverity}" Title="{Binding BannerTitle}" Message="{Binding BannerMessage}"
                              CloseCommand="{Binding DismissBannerCommand}" MaxWidth="{StaticResource DevBR.ContentMaxWidth}" HorizontalAlignment="Stretch"
                              Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <controls:InfoBar.ActionContent>
                    <Button Style="{StaticResource Button.Secondary}" Content="Review" Command="{Binding ReviewInterruptedRestoreCommand}"
                            AutomationProperties.Name="Review the interrupted restore"
                            Visibility="{Binding IsReviewRestoreVisible, Converter={StaticResource BoolToVisibility}}" />
                </controls:InfoBar.ActionContent>
            </controls:InfoBar>

            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          AutomationProperties.Name="{Binding SelectedPage.Title}">
                <ContentControl x:Name="PageHost" Content="{Binding SelectedPage}" Margin="{StaticResource DevBR.PagePadding}"
                                MaxWidth="{StaticResource DevBR.ContentMaxWidth}" HorizontalAlignment="Stretch" Focusable="False" IsTabStop="False">
                    <ContentControl.RenderTransform>
                        <TranslateTransform />
                    </ContentControl.RenderTransform>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
